@model TaskManager.ViewModels.ProjectMemberViewModels.ProjectMemberAddViewModel

@{
    ViewData["Title"] = "Add Project Member";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="mb-4">

                <h2 class="fw-bold mb-1">
                    Add Project Member
                </h2>

                <p class="text-muted mb-0">
                    Add a registered user to this project by email.
                </p>

            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="ProjectMembers"
                          asp-action="Add"
                          method="post">

                        <input asp-for="ProjectId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                User Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="user@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                The user must already have a TaskManager account.
                            </div>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="ProjectMembers"
                               asp-action="Index"
                               asp-route-projectId="@Model.ProjectId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Member
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}