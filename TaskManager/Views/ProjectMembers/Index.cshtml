@model TaskManager.ViewModels.ProjectMemberViewModels.ProjectMembersPageViewModel

@{
    ViewData["Title"] = "Project Members";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Project Members
            </h2>

            <p class="text-muted mb-0">
                Project: @Model.ProjectName
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId"
               class="btn btn-outline-secondary">
                Back to Project
            </a>

            <a asp-controller="ProjectMembers"
               asp-action="Add"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-primary">
                Add Member
            </a>

        </div>

    </div>

    @if (!Model.Members.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h4 class="mb-3">
                    No members yet
                </h4>

                <p class="text-muted mb-4">
                    Add users to this project to start collaborating.
                </p>

                <a asp-controller="ProjectMembers"
                   asp-action="Add"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn btn-primary">
                    Add Member
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Email</th>
                                <th>Joined On</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var member in Model.Members)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @member.FullName
                                    </td>

                                    <td>
                                        @member.Email
                                    </td>

                                    <td>
                                        @member.JoinedOn.ToString("dd.MM.yyyy")
                                    </td>

                                    <td class="text-end pe-4">

                                        <form asp-controller="ProjectMembers"
                                              asp-action="Remove"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="projectId"
                                                   value="@Model.ProjectId" />

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@member.UserId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Remove
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>