@model TaskManager.ViewModels.TaskViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Task Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">@Model.Title</h2>

            <p class="text-muted mb-0">
                Task details and progress
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Tasks"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Edit
            </a>

            <a asp-controller="Tasks"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Delete
            </a>

        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Task Information
                    </h5>

                    <p>
                        <strong>Description:</strong>
                    </p>

                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "No description provided."
                                                : Model.Description)
                    </p>

                    <hr />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Status</strong>

                            <div class="text-muted">
                                @Model.Status
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Priority</strong>

                            <div class="text-muted">
                                @Model.Priority
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Assigned To</strong>

                            <div class="text-muted">

                                @if (string.IsNullOrWhiteSpace(Model.AssignedUserName))
                                {
                                    <span>Unassigned</span>
                                }
                                else
                                {
                                    @Model.AssignedUserName
                                }

                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Created On</strong>

                            <div class="text-muted">
                                @Model.CreatedOn.ToString("dd.MM.yyyy")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Deadline</strong>

                            <div class="text-muted">

                                @if (Model.Deadline.HasValue)
                                {
                                    @Model.Deadline.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>No deadline</span>
                                }

                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Completed On</strong>

                            <div class="text-muted">

                                @if (Model.CompletedOn.HasValue)
                                {
                                    @Model.CompletedOn.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>Not completed</span>
                                }

                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Project
                    </h5>

                    <p class="mb-3">
                        @Model.ProjectName
                    </p>

                    <a asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@Model.ProjectId"
                       class="btn btn-outline-secondary w-100">
                        View Project
                    </a>

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            Comments
                        </h5>

                        <span class="badge bg-secondary">
                            @Model.CommentsCount
                        </span>
                    </div>

                    <hr />

                    <p class="text-muted mb-0">
                        Comments will appear here.
                    </p>

                </div>
            </div>

        </div>

    </div>

    <div class="mt-4">

        <a asp-controller="Tasks"
           asp-action="Index"
           asp-route-projectId="@Model.ProjectId"
           class="btn btn-outline-secondary">
            Back to Tasks
        </a>

    </div>

</div>