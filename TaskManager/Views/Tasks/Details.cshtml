@model TaskManager.ViewModels.TaskViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Task Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">@Model.Title</h2>

            <p class="text-muted mb-0">
                Task details and progress
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Tasks"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Edit
            </a>

            <a asp-controller="Tasks"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Delete
            </a>

        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Task Information
                    </h5>

                    <p>
                        <strong>Description:</strong>
                    </p>

                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "No description provided."
                                                : Model.Description)
                    </p>

                    <hr />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Status</strong>

                            <div class="text-muted">
                                @Model.Status
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Priority</strong>

                            <div class="text-muted">
                                @Model.Priority
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Assigned To</strong>

                            <div class="text-muted">

                                @if (string.IsNullOrWhiteSpace(Model.AssignedUserName))
                                {
                                    <span>Unassigned</span>
                                }
                                else
                                {
                                    @Model.AssignedUserName
                                }

                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Created On</strong>

                            <div class="text-muted">
                                @Model.CreatedOn.ToString("dd.MM.yyyy")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Deadline</strong>

                            <div class="text-muted">

                                @if (Model.Deadline.HasValue)
                                {
                                    @Model.Deadline.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>No deadline</span>
                                }

                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Completed On</strong>

                            <div class="text-muted">

                                @if (Model.CompletedOn.HasValue)
                                {
                                    @Model.CompletedOn.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>Not completed</span>
                                }

                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Project
                    </h5>

                    <p class="mb-3">
                        @Model.ProjectName
                    </p>

                    <a asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@Model.ProjectId"
                       class="btn btn-outline-secondary w-100">
                        View Project
                    </a>

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            Comments
                        </h5>

                        <span class="badge bg-secondary">
                            @Model.CommentsCount
                        </span>
                    </div>

                    <hr />

                    @if (!Model.Comments.Any())
                    {
                        <p class="text-muted">
                            No comments yet.
                        </p>
                    }
                    else
                    {
                        <div class="mb-4">

                            @foreach (var comment in Model.Comments)
                            {
                                <div class="border rounded p-3 mb-3">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div>
                                            <strong>
                                                @comment.AuthorName
                                            </strong>

                                            <div class="text-muted small">
                                                @comment.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        </div>

                                        @if (comment.AuthorId == User.FindFirst(
                                                                        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                        {
                                            <form asp-controller="Comments"
                                                  asp-action="Delete"
                                                  method="post">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@comment.Id" />

                                                <input type="hidden"
                                                       name="taskId"
                                                       value="@Model.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </div>

                                    <p class="mt-3 mb-0">
                                        @comment.Content
                                    </p>

                                </div>
                            }

                        </div>
                    }

                    <hr />

                    <h6 class="mb-3">
                        Add Comment
                    </h6>

                    <form asp-controller="Comments"
                          asp-action="Create"
                          method="post">

                        <input type="hidden"
                               name="TaskItemId"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <textarea name="Content"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Write a comment..."></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Add Comment
                        </button>

                    </form>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-4">

        <a asp-controller="Tasks"
           asp-action="Index"
           asp-route-projectId="@Model.ProjectId"
           class="btn btn-outline-secondary">
            Back to Tasks
        </a>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}