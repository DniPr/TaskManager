@model TaskManager.ViewModels.TaskViewModels.TaskIndexPageViewModel

@{
    ViewData["Title"] = "Tasks";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Tasks
            </h2>

            <p class="text-muted mb-0">
                Project: @Model.ProjectName
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId"
               class="btn btn-outline-secondary">
                Back to Project
            </a>

            <a asp-controller="Tasks"
               asp-action="Create"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-primary">
                Create Task
            </a>

        </div>

    </div>

    @if (!Model.Tasks.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h4 class="mb-3">
                    No tasks yet
                </h4>

                <p class="text-muted mb-4">
                    Create the first task for this project.
                </p>

                <a asp-controller="Tasks"
                   asp-action="Create"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn btn-primary">
                    Create Task
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var task in Model.Tasks)
            {

                    string statusClass = task.Status switch
                    {
                        TaskManager.Models.Enums.TaskItemStatus.ToDo => "task-todo",
                        TaskManager.Models.Enums.TaskItemStatus.InProgress => "task-inprogress",
                        TaskManager.Models.Enums.TaskItemStatus.Completed => "task-completed",
                        _ => ""
                    };

                <div class="col-md-6 col-xl-4">

                    <div class="card shadow-sm h-100 task-card @statusClass"
                         id="task-card-@task.Id">

                        <div class="card-body d-flex flex-column p-4">

                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                                <h4 class="card-title mb-0 task-title @(task.Status == TaskManager.Models.Enums.TaskItemStatus.Completed ? "task-title-completed" : "")"
                                    id="task-title-@task.Id">
                                    @task.Title
                                </h4>

                                @switch (task.Priority)
                                {
                                    case TaskManager.Models.Enums.TaskPriority.Low:
                                        <span class="badge bg-secondary">
                                            Low
                                        </span>
                                        break;

                                    case TaskManager.Models.Enums.TaskPriority.Medium:
                                        <span class="badge bg-primary">
                                            Medium
                                        </span>
                                        break;

                                    case TaskManager.Models.Enums.TaskPriority.High:
                                        <span class="badge bg-warning text-dark">
                                            High
                                        </span>
                                        break;

                                    case TaskManager.Models.Enums.TaskPriority.Critical:
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                        break;
                                }

                            </div>

                            <div class="mb-3">

                                <span class="text-muted d-block mb-1">
                                    Status
                                </span>

                                @if (task.CanModify)
                                {
                                    <select class="form-select form-select-sm task-status-select"
                                            data-task-id="@task.Id">

                                        <option value="1"
                                                selected="@(task.Status == TaskManager.Models.Enums.TaskItemStatus.ToDo)">
                                            To Do
                                        </option>

                                        <option value="2"
                                                selected="@(task.Status == TaskManager.Models.Enums.TaskItemStatus.InProgress)">
                                            In Progress
                                        </option>

                                        <option value="3"
                                                selected="@(task.Status == TaskManager.Models.Enums.TaskItemStatus.Completed)">
                                            Completed
                                        </option>

                                    </select>
                                    <small class="task-status-message mt-1 d-block"></small>
                                    <span class="task-status-badge d-none"></span>
                                }
                                else
                                {
                                    @switch (task.Status)
                                    {
                                        case TaskManager.Models.Enums.TaskItemStatus.ToDo:
                                            <span class="badge bg-secondary">
                                                To Do
                                            </span>
                                            break;

                                        case TaskManager.Models.Enums.TaskItemStatus.InProgress:
                                            <span class="badge bg-warning text-dark">
                                                In Progress
                                            </span>
                                            break;

                                        case TaskManager.Models.Enums.TaskItemStatus.Completed:
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                            break;
                                    }
                                }
                        </div>

                        <div class="mb-3">

                            <div class="d-flex justify-content-between mb-2">

                                <span class="text-muted">
                                    Assigned To
                                </span>

                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(task.AssignedUserName)
                                                                    ? "Unassigned"
                                                                    : task.AssignedUserName)
                                                                                        </span>

                            </div>

                            <div class="d-flex justify-content-between">

                                <span class="text-muted">
                                    Deadline
                                </span>

                                <span class="fw-semibold">
                                    @(task.Deadline.HasValue
                                                                    ? task.Deadline.Value.ToString("dd.MM.yyyy")
                                                                    : "No deadline")
                            </span>

                                </div>

                            </div>

                            <div class="mt-auto">

                                <a asp-controller="Tasks"
                                   asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="btn btn-outline-primary w-100">
                                    View Task
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
                }

        </div>
    }

</div>

@section Scripts {
    <script src="~/js/tasks.js"></script>
}