@model TaskManager.ViewModels.TaskViewModels.TaskIndexPageViewModel

@{
    ViewData["Title"] = "Tasks";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                @Model.ProjectName
            </h2>

            <p class="text-muted mb-0">
                Manage and track the tasks for this project.
            </p>
        </div>

        <a asp-controller="Tasks"
           asp-action="Create"
           asp-route-projectId="@Model.ProjectId"
           class="btn btn-primary">
            Create Task
        </a>
    </div>

    @if (!Model.Tasks.Any())
    {
        <div class="alert alert-info">
            There are no tasks in this project yet.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var task in Model.Tasks)
            {
                <div class="col-12">

                    <div class="card shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>
                                    <h5 class="card-title mb-2">
                                        @task.Title
                                    </h5>

                                    <p class="mb-1">
                                        <strong>Status:</strong>
                                        @task.Status
                                    </p>

                                    <p class="mb-1">
                                        <strong>Priority:</strong>
                                        @task.Priority
                                    </p>

                                    <p class="mb-1">
                                        <strong>Assigned to:</strong>

                                        @if (string.IsNullOrWhiteSpace(task.AssignedUserName))
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            @task.AssignedUserName
                                        }
                                    </p>

                                    <p class="mb-0">
                                        <strong>Deadline:</strong>

                                        @if (task.Deadline.HasValue)
                                        {
                                            @task.Deadline.Value.ToString("dd.MM.yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No deadline
                                            </span>
                                        }
                                    </p>
                                </div>

                                <div>
                                    <a asp-controller="Tasks"
                                       asp-action="Details"
                                       asp-route-id="@task.Id"
                                       class="btn btn-outline-primary">
                                        Details
                                    </a>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Projects"
           asp-action="Details"
           asp-route-id="@Model.ProjectId"
           class="btn btn-outline-secondary">
            Back to Project
        </a>
    </div>

</div>