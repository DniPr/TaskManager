@model TaskManager.ViewModels.TaskViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Delete Task";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-danger">
                <div class="card-body p-4">

                    <h2 class="text-danger mb-3">
                        Delete Task
                    </h2>

                    <p class="mb-4">
                        Are you sure you want to delete this task?
                    </p>

                    <div class="mb-4">

                        <h5>@Model.Title</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted">
                                @Model.Description
                            </p>
                        }

                        <p class="mb-1">
                            <strong>Project:</strong>
                            @Model.ProjectName
                        </p>

                        <p class="mb-1">
                            <strong>Status:</strong>
                            @Model.Status
                        </p>

                        <p class="mb-1">
                            <strong>Priority:</strong>
                            @Model.Priority
                        </p>

                        <p class="mb-0">
                            <strong>Assigned To:</strong>

                            @if (string.IsNullOrWhiteSpace(Model.AssignedUserName))
                            {
                                <span class="text-muted">
                                    Unassigned
                                </span>
                            }
                            else
                            {
                                @Model.AssignedUserName
                            }
                        </p>

                    </div>

                    <div class="alert alert-warning">
                        Deleting this task will also remove its related comments.
                    </div>

                    <form asp-controller="Tasks"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@Model.Id"
                          method="post">

                        <input type="hidden"
                               name="projectId"
                               value="@Model.ProjectId" />

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Tasks"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Task
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>