@model TaskManager.ViewModels.ProjectViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                @Model.Name
            </h2>

            <p class="text-muted mb-0">
                Project overview and management.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            @if (Model.IsOwner)
            {
                <a asp-controller="Projects"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    Edit Project
                </a>

                <a asp-controller="Projects"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">
                    Delete Project
                </a>
            }

            <a asp-controller="Projects"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Projects
            </a>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-8">

            <div class="card shadow-sm h-100">
                <div class="card-body p-4">

                    <h4 class="mb-3">
                        Project Information
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-4">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            No description provided.
                        </p>
                    }

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="project-detail-item">

                                <span class="text-muted d-block">
                                    Owner
                                </span>

                                <span class="fw-semibold">
                                    @Model.OwnerName
                                </span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="project-detail-item">

                                <span class="text-muted d-block">
                                    Created On
                                </span>

                                <span class="fw-semibold">
                                    @Model.CreatedOn.ToString("dd.MM.yyyy")
                                </span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="project-detail-item">

                                <span class="text-muted d-block">
                                    Deadline
                                </span>

                                <span class="fw-semibold">
                                    @(Model.Deadline.HasValue
                                                                        ? Model.Deadline.Value.ToString("dd.MM.yyyy")
                                                                        : "No deadline")
                                </span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="project-detail-item">

                                <span class="text-muted d-block">
                                    Your Access
                                </span>

                                @if (Model.IsOwner)
                                {
                                    <span class="badge bg-primary">
                                        Project Owner
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Project Member
                                    </span>
                                }

                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm h-100">
                <div class="card-body p-4">

                    <h4 class="mb-4">
                        Project Statistics
                    </h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Members
                        </span>

                        <span class="fw-bold">
                            @Model.MembersCount
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Tasks
                        </span>

                        <span class="fw-bold">
                            @Model.TasksCount
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">
                            Completed Tasks
                        </span>

                        <span class="fw-bold">
                            @Model.CompletedTasksCount
                        </span>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-6">

            <div class="card shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="mb-2">
                        Tasks
                    </h4>

                    <p class="text-muted">
                        View and manage tasks for this project.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Tasks"
                           asp-action="Index"
                           asp-route-projectId="@Model.Id"
                           class="btn btn-primary">
                            View Tasks
                        </a>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column">

                    <h4 class="mb-2">
                        Project Members
                    </h4>

                    <p class="text-muted">
                        View the users participating in this project.
                    </p>

                    <div class="mt-auto">

                        @if (Model.IsOwner)
                        {
                            <a asp-controller="ProjectMembers"
                               asp-action="Index"
                               asp-route-projectId="@Model.Id"
                               class="btn btn-primary">
                                Manage Members
                            </a>
                        }
                        else
                        {
                            <a asp-controller="ProjectMembers"
                               asp-action="Index"
                               asp-route-projectId="@Model.Id"
                               class="btn btn-outline-primary">
                                View Members
                            </a>
                        }

                    </div>

                </div>
            </div>

        </div>

    </div>

</div>