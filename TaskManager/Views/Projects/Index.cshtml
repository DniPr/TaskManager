@model IEnumerable<TaskManager.ViewModels.ProjectViewModels.ProjectIndexViewModel>

@{
    ViewData["Title"] = "Projects";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Projects
            </h2>

            <p class="text-muted mb-0">
                Manage your projects, tasks and team collaboration.
            </p>
        </div>

        <a asp-controller="Projects"
           asp-action="Create"
           class="btn btn-primary">
            Create Project
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h4 class="mb-3">
                    No projects yet
                </h4>

                <p class="text-muted mb-4">
                    Create your first project and start organizing your tasks.
                </p>

                <a asp-controller="Projects"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Project
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="card shadow-sm h-100 project-card">

                        <div class="card-body d-flex flex-column">

                            <div class="mb-3">

                                <h4 class="card-title mb-2">
                                    @project.Name
                                </h4>

                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <p class="text-muted">
                                        @project.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        No description provided.
                                    </p>
                                }

                            </div>

                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">
                                        Owner
                                    </span>

                                    <span class="fw-semibold">
                                        @project.OwnerName
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">
                                        Members
                                    </span>

                                    <span class="fw-semibold">
                                        @project.MembersCount
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">
                                        Tasks
                                    </span>

                                    <span class="fw-semibold">
                                        @project.TasksCount
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">
                                        Completed
                                    </span>

                                    <span class="fw-semibold">
                                        @project.CompletedTasksCount
                                    </span>
                                </div>

                            </div>

                            @if (project.Deadline.HasValue)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-light text-dark border">
                                        Deadline:
                                        @project.Deadline.Value.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            }

                            <div class="mt-auto">

                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-id="@project.Id"
                                   class="btn btn-outline-primary w-100">
                                    View Project
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>