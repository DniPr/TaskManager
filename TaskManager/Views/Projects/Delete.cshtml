@model TaskManager.ViewModels.ProjectViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-danger">

                <div class="card-body p-4">

                    <h2 class="fw-bold text-danger mb-3">
                        Delete Project
                    </h2>

                    <p class="text-muted mb-4">
                        Are you sure you want to delete this project?
                        This action cannot be undone.
                    </p>

                    <div class="p-3 bg-light rounded mb-4">

                        <h4 class="mb-2">
                            @Model.Name
                        </h4>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted mb-2">
                                @Model.Description
                            </p>
                        }

                        <div class="small text-muted">
                            Owner: @Model.OwnerName
                        </div>

                    </div>

                    <div class="alert alert-warning">
                        Deleting this project will also remove its related
                        tasks and project data.
                    </div>

                    <form asp-controller="Projects"
                          asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Projects"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Project
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>