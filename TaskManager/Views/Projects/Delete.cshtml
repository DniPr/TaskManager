@model TaskManager.ViewModels.ProjectViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-danger">
                <div class="card-body p-4">

                    <h2 class="text-danger mb-3">Delete Project</h2>

                    <p class="mb-4">
                        Are you sure you want to delete this project?
                    </p>

                    <div class="mb-4">
                        <h5>@Model.Name</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted">
                                @Model.Description
                            </p>
                        }

                        <p class="mb-1">
                            <strong>Owner:</strong>
                            @Model.OwnerName
                        </p>

                        <p class="mb-1">
                            <strong>Tasks:</strong>
                            @Model.TasksCount
                        </p>

                        <p class="mb-0">
                            <strong>Members:</strong>
                            @Model.MembersCount
                        </p>
                    </div>

                    <div class="alert alert-warning">
                        Deleting this project will also remove its related tasks,
                        comments and project memberships.
                    </div>

                    <form asp-controller="Projects"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@Model.Id"
                          method="post">

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Projects"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Project
                            </button>

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>